# CinePrime Environment Configuration Template
DEBUG=True
SECRET_KEY=cineprime-change-this-secret-key-in-production-12345
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Database Configuration (PostgreSQL in Prod, SQLite in Dev)
# DATABASE_URL=postgres://cineprime_user:cineprime_secure_password@localhost:5432/cineprime_db

# Redis & Channels Configuration
USE_REDIS=False
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Celery Configuration
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Payment Gateway API Keys
PAYMENT_GATEWAY_KEY=rzp_test_samplekey123
PAYMENT_GATEWAY_SECRET=cineprime_secret_key

# Email Server (SMTP - Gmail Configuration)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=CinePrime Cinemas <your_email@gmail.com>
